using Gtk 4.0;
using Adw 1;

template $PreferencesDialog: Adw.PreferencesDialog {
    height-request: 600;
    width-request: 200;

    Adw.PreferencesPage {
        title: _("Interface");

        Adw.PreferencesGroup {
            title: _("Color scheme");

            FlowBox colorschemes {
                row-spacing: 12;
                column-spacing: 12;
                max-children-per-line: 4;
                min-children-per-line: 4;
                selection-mode: none;
            }
        }

        Adw.PreferencesGroup {
            title: _("Appearance");

            Adw.ComboRow theme_variant {
                title: _("Theme variant");

                model: Gtk.StringList {
                    strings [
                        _("System"),
                        _("Light"),
                        _("Dark"),
                    ]
                };
            }

            Adw.SwitchRow line_hl {
                title: _("Highlight current line");
            }

            Adw.SwitchRow minimap {
                title: _("Show minimap");
            }

            Adw.SwitchRow grid_bg {
                title: _("Use grid background");
            }

            Adw.SwitchRow word_wrap {
                title: _("Use word wrap");
            }

            Adw.SwitchRow custom_corners_toggle {
                title: _("Use a custom corner radius");
            }
            
            Adw.SpinRow custom_corners {
                title: _("Custom corner radius");
                subtitle: _("Uses custom CSS - use at your own risk!");
                adjustment: Adjustment {
                  lower: 0;
                  upper: 128;
                  value: 0;
                  step-increment: 1;
                };
            }

            Adw.SwitchRow custom_opacity_toggle {
                title: _("Use a custom opacity");
            }
            
            Adw.SpinRow custom_opacity {
                title: _("Custom opacity");
                subtitle: _("Uses custom CSS - use at your own risk!");
                adjustment: Adjustment {
                  lower: 0.0;
                  upper: 100.0;
                  value: 100.0;
                  step-increment: 1.0;
                };
            }
        }

        Adw.PreferencesGroup {
            title: _("Sidebar");

            Adw.SwitchRow show_hidden {
                title: _("Show hidden files and folders");
            }
        }
    }
}
