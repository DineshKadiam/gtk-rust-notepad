using Gtk 4.0;
using Adw 1;

template $PreferencesDialog: Adw.PreferencesDialog {
    height-request: 600;
    width-request: 200;

    Adw.PreferencesPage {
        title: "UI";

        Adw.PreferencesGroup {
            title: _("Color scheme");

            FlowBox colorschemes {
                row-spacing: 12;
                column-spacing: 12;
                max-children-per-line: 4;
                min-children-per-line: 4;
                selection-mode: none;
            }
        }

        Adw.PreferencesGroup {
            title: _("Appearance");

            Adw.ComboRow theme_variant {
                title: _("Theme variant");

                model: Gtk.StringList {
                    strings [
                        _("System"),
                        _("Light"),
                        _("Dark"),
                    ]
                };
            }

            Adw.SwitchRow line_hl {
                title: _("Highlight current line");
            }

            Adw.SwitchRow minimap {
                title: _("Show minimap");
            }

            Adw.SwitchRow grid_bg {
                title: _("Use grid background");
            }
        }
    }
}
