using Gtk 4.0;
using Adw 1;
using Panel 1;

template $EditorWindow: Adw.ApplicationWindow {
    Adw.Breakpoint {
        condition("max-width: 600sp")
        setters {
          split_view.collapsed: true;
        }
    }

    [content]
    Adw.OverlaySplitView split_view {
        min-sidebar-width: 256;
        sidebar-width-fraction: 0.4;
        show-sidebar: false;

        [sidebar]
        Adw.ToolbarView {

            [top]
            Adw.HeaderBar {
                title-widget: Adw.WindowTitle sidebar_title {
                  title: _("waf?");
                };

                [end]
                MenuButton {
                    icon-name: "open-menu-symbolic";
                    menu-model: menu {
                        section {
                            label: _("File");
                            item {
                              label: _("New window");
                              action: "win.new_window";
                            }
                            item {
                              label: _("New terminal tab");
                              action: "win.tab.new_terminal";
                            }
                            item {
                              label: _("New scratch buffer");
                              action: "win.tab.new_scratch";
                            }
                            item {
                              label: _("Open file");
                              icon: "document-open-symbolic";
                              action: "win.open.file";
                            }
                            item {
                              label: _("Open folder");
                              icon: "folder-open-symbolic";
                              action: "win.open.folder";
                            }
                            item {
                              label: _("Save");
                              icon: "document-save-symbolic";
                              action: "win.save";
                            }
                            item {
                              label: _("Save as...");
                              icon: "document-save-as-symbolic";
                              action: "win.save_as";
                            }
                        }
                        section {
                            label: _("Edit");
                            item {
                              label: _("Close current tab");
                              action: "win.tab.close";
                            }
                            item {
                              label: _("Search for text");
                              action: "win.search.toggle";
                            }
                            item {
                                label: _("Preferences");
                                action: "win.show_prefs";
                            }
                        }
                    };
                }

            }

            ScrolledWindow {
                hscrollbar-policy: external;

                Adw.ClampScrollable {
                    [child]
                    ListView file_tree {
                        styles[
                            "navigation-sidebar"
                        ]

                    }
                }
            }

        }

        [content]
        Adw.TabOverview tab_overview {
            view: tab_view;
            enable-new-tab: true;
            enable-search: true;

            Adw.ToolbarView {
                top-bar-style: raised_border;
                bottom-bar-style: raised_border;

                [top]
                Adw.HeaderBar {
                    Button {
                        icon-name: "sidebar-show-symbolic";
                        action-name: "win.sidebar.toggle";
                    }

                    Adw.TabButton {
                        view: tab_view;
                        action-name: "overview.open";
                    }

                    title-widget: Adw.WindowTitle window_title {
                      title: _("spikedit");
                    };
                }

                [top]
                Adw.TabBar {
                    view: tab_view;
                }

                [bottom]
                SearchBar search_bar {
                    Box {
                        spacing: 8;
                        margin-start: 8;
                        margin-end: 8;
                        SearchEntry search_entry {
                            styles ["flat"]
                            hexpand: true;
                            placeholder-text: _("Search");
                        }
                        // ToggleButton {
                        //     icon-name: "edit-find-replace-symbolic";
                        // }
                        Button {
                            icon-name: "window-close-symbolic";
                            action-name: "win.search.toggle";
                        }
                    }
                }

                Box {
                    orientation: vertical;


                    Panel.Dock dock {
                        vexpand: true;

                        [content]
                        Adw.TabView tab_view {
                            vexpand: true;
                            menu-model: menu {
                                section {
                                    item {
                                        label: _("Pin tab");
                                        action: "tab_context.pin";
                                        hidden-when: 'action-disabled';
                                    }
                                    item {
                                        label: _("Unpin tab");
                                        action: "tab_context.unpin";
                                        hidden-when: 'action-disabled';
                                    }
                                }
                                section {
                                    item {
                                        label: _("Move left");
                                        action: "tab_context.move_left";
                                    }
                                    item {
                                        label: _("Move right");
                                        action: "tab_context.move_right";
                                    }
                                    item {
                                        label: _("Move to new window");
                                        action: "tab_context.move_new";
                                    }
                                }
                                section {
                                    item {
                                        label: _("Close tab");
                                        action: "tab_context.close";
                                    }
                                    item {
                                        label: _("Close tabs to the left");
                                        action: "tab_context.close_left";
                                    }
                                    item {
                                        label: _("Close tabs to the right");
                                        action: "tab_context.close_left";
                                    }
                                    item {
                                        label: _("Close other tabs");
                                        action: "tab_context.close_other";
                                    }
                                }
                            };

                            Adw.TabPage {
                                title: _("Welcome");

                                child: $WelcomeScreen startpage {};
                            }
                        }

                        [bottom]
                        $TerminalView terminal_view {
                            height-request: 200;
                        }
                    }

                    Separator {
                        orientation: horizontal;
                    }

                    /* Status bar */
                    CenterBox {
                        styles[
                            "status-bar"
                        ]

                        orientation: horizontal;
                        margin-start: 8;
                        // margin-end: 8;

                        [start]
                        Box {
                            spacing: 8;

                            /* TODO these are placeholders!! */
                            Label {
                                styles[
                                    "monospace"
                                ]
                                label: "NORMAL";
                            }

                            Separator {
                                orientation: vertical;
                            }

                            Label {
                                label: "full/path/to/file";
                            }

                            Separator {
                                orientation: vertical;
                            }

                            Label {
                                label: "lang";
                            }

                            Separator {
                                orientation: vertical;
                            }

                        }

                        [end]
                        Box {
                            Separator {
                                orientation: vertical;
                            }

                            Panel.ToggleButton toggle_terminal_button {
                                dock: dock;
                                area: bottom;
                                styles[
                                    "compressed",
                                    "flat"
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}
