using Gtk 4.0;
using Adw 1;

template $NotificationsView: Adw.Bin {
	MenuButton {
		icon-name: "dialog-information-symbolic";

		popover: Popover {
			styles [
				"notifs-popover",
			]

			ScrolledWindow {
				width-request: 400;
				height-request: 256;

				ListBox notifs_list {
					styles [
						"notifs-list",
					]
				}
			}
		};
	}
}
