using Gtk 4.0;
using Adw 1;

template $NotificationsView: Adw.Bin {
  MenuButton button {
    icon-name: "notifications-symbolic";
    visible: false;

    styles [
      "notifs-button",
    ]

    popover: Popover {
      has-arrow: false;

      styles [
        "notifs-popover",
      ]

      ScrolledWindow {
        width-request: 400;
        max-content-height: 512;
        max-content-width: 400;
        propagate-natural-height: true;
        hscrollbar-policy: never;

        ListBox notifs_list {
          selection-mode: none;
          accept-unpaired-release: true;

          styles [
            "notifs-list",
            "boxed-list",
          ]

          Adw.ButtonRow clear_button {
            styles [
              "destructive-action",
            ]

            action-name: "notifs.clear";
            start-icon-name: "edit-clear-all-symbolic";
            title: _("Clear all");
          }
        }
      }
    };
  }
}
