using Gtk 4.0;
using Adw 1;

template $NotificationsView: Adw.Bin {
	MenuButton button {
		icon-name: "notifications-symbolic";

		popover: Popover {
			has-arrow: false;

			styles [
				"notifs-popover",
			]

			ScrolledWindow {
				width-request: 400;
				max-content-height: 256;
				propagate-natural-height: true;

				ListBox notifs_list {
					selection-mode: none;
					accept-unpaired-release: true;

					styles [
						"notifs-list",
						"boxed-list",
					]

					ListBoxRow {
						activatable: false;
						Button clear_button {
							styles [
								"pill"
							]
							action-name: "default.activate";
							label: _("Clear all");
							margin-bottom: 8;
							margin-top: 8;
							margin-start: 8;
							margin-end: 8;
						}
					}
				}
			}
		};
	}
}
