using Gtk 4.0;
using Adw 1;

template $WelcomeScreen: Adw.Bin {
  Adw.StatusPage {
    icon-name: "ca.potatoe.Kyanite-symbolic";
    title: _("Welcome");
    description: _("Choose an option to get started.");

    child: Box {
      orientation: vertical;
      halign: center;
      spacing: 12;

      Button {
        styles [
          "suggested-action",
          "pill",
        ]

        label: _("Open recent…");
        action-name: "win.show_recents";
      }

      Box {
        spacing: 12;

        Button {
          styles [
            "pill",
          ]

          label: _("Open file…");
          action-name: "win.open.file";
        }

        Button {
          styles [
            "circular",
          ]

          icon-name: "folder-open-symbolic";
          action-name: "win.open.folder";
        }

        Button {
          styles [
            "circular",
          ]

          icon-name: "document-new-symbolic";
          action-name: "win.tab.new_scratch";
        }
      }
    };
  }
}
