using Gtk 4.0;
using GtkSource 5;

template $Buffer: Box {
  orientation: horizontal;

  diagnostic_provider: GtkSource.AnnotationProvider {};

  ScrolledWindow {
    vscrollbar-policy: external;

    GtkSource.View source_view {
      vexpand: true;
      hexpand: true;
      monospace: true;
      show-line-numbers: true;
      show-line-marks: true;
      top-margin: 12;
      bottom-margin: 32;
      pixels-below-lines: 4;
      // Helix-like indentation
      left-margin: 4;
      tab-width: 4;
      insert-spaces-instead-of-tabs: true;
      indent-width: 4;
      auto-indent: true;
      // Extra options
      extra-menu: menu {
        section {
          item (_("Code actions…"), "buffer.lsp.actions")
          item (_("LSP hover…"), "buffer.lsp.hover")
        }
      };
    }
  }

  Revealer map_revealer {
    transition-type: slide_left;

    GtkSource.Map source_map {
      halign: end;
      valign: fill;
      view: source_view;
      highlight-current-line: true;
      vexpand: true;
    }
  }
}
