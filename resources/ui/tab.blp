using Gtk 4.0;
using GtkSource 5;

template $Buffer: Box {
    ScrolledWindow {
        vscrollbar-policy: external;

        GtkSource.View source_view {
            monospace: true;
            show-line-numbers: true;
            tab-width: 4;
            top-margin: 4;
            bottom-margin: 4;
            hexpand: true;
            // configurable things
            highlight-current-line: true;
            background-pattern: grid;
        }
    }

    GtkSource.Map {
        view: source_view;
        font-desc: "None 2";
    }
}
