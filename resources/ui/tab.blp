using Gtk 4.0;
using GtkSource 5;
using Adw 1;

template $Buffer: Box {
    ScrolledWindow {
        vscrollbar-policy: external;

        GtkSource.View source_view {
            monospace: true;
            show-line-numbers: true;
            show-line-marks: true;
            tab-width: 4;
            top-margin: 12;
            bottom-margin: 4;
            pixels-below-lines: 4;
            hexpand: true;
            // configurable things
            highlight-current-line: true;
            //background-pattern: grid;
            //
            //
        }
    }

    GtkSource.Map source_map {
        halign: end;
        valign: fill;
        view: source_view;
        font-desc: "None 2";
        highlight-current-line: true;
        vexpand: true;
    }
}
