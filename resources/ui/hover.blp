using Gtk 4.0;
using Adw 1;

template $HoverDialog: Adw.Dialog {
  title: _("Details");
  width-request: 600;
  follows-content-size: true;
  presentation-mode: bottom_sheet;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.ScrolledWindow {
      propagate-natural-height: true;
      min-content-height: 300;
      max-content-height: 600;
      margin-bottom: 16;

      Adw.Clamp {
        maximum-size: 600;
        tightening-threshold: 400;

        Adw.Bin bin {}
      }
    };
  }
}
