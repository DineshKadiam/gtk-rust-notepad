using Gtk 4.0;
using Adw 1;

template $HoverDialog: Adw.Dialog {
  title: _("Details");
  height-request: 400;
  width-request: 600;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.ScrolledWindow {
      Adw.Clamp {
        maximum-size: 600;
        tightening-threshold: 400;

        Adw.Bin bin {}
      }
    };
  }
}
