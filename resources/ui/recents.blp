using Gtk 4.0;
using Adw 1;

template $RecentsDialog: Adw.Dialog {
	height-request: 600;
	width-request: 600;

	Adw.ToolbarView {
		[top]
		Adw.HeaderBar {
			title-widget: Adw.ViewSwitcher {
				stack: stack;
				policy: wide;
			};
		}

		content: Adw.ViewStack stack {
			Adw.ViewStackPage {
				name: "starred";
				title: _("Starred");
				icon-name: "starred-symbolic";

				child: Gtk.ScrolledWindow {
					Adw.Clamp {
						maximum-size: 600;
						tightening-threshold: 400;

						Box {
							margin-top: 16;
							margin-bottom: 16;
							orientation: vertical;
							spacing: 32;

							styles [
								"large",
							]

							Adw.StatusPage starred_status {
								icon-name: "starred-symbolic";
								title: _("Nothing’s starred…");
								description: _("Click the star icon on a recent file or folder. This page will refresh whenever you reopen this dialog.");
								vexpand: true;
							}

							Box {
								orientation: vertical;
								spacing: 8;

								Label {
									label: _("Folders");
									halign: start;

									styles [
										"heading",
										"h4",
									]
								}

								ListBox starred_folders {
									selection-mode: none;

									styles [
										"boxed-list",
									]
								}
							}

							Box {
								orientation: vertical;
								spacing: 8;

								Label {
									label: _("Files");
									halign: start;

									styles [
										"heading",
										"h4",
									]
								}

								ListBox starred_files {
									selection-mode: none;

									styles [
										"boxed-list",
									]
								}
							}
						}
					}
				};
			}

			Adw.ViewStackPage {
				name: "files";
				title: _("Files");
				icon-name: "text-x-generic-symbolic";

				child: Gtk.ScrolledWindow {
					Adw.Clamp {
						maximum-size: 600;
						tightening-threshold: 400;

						Adw.Bin {
							margin-top: 16;
							margin-bottom: 16;

							styles [
								"large",
							]

							ListBox files {
								selection-mode: none;

								styles [
									"boxed-list",
								]
							}
						}
					}
				};
			}

			Adw.ViewStackPage {
				name: "folders";
				title: _("Folders");
				icon-name: "folder-symbolic";

				child: Gtk.ScrolledWindow {
					Adw.Clamp {
						maximum-size: 600;
						tightening-threshold: 400;

						Adw.Bin {
							margin-top: 16;
							margin-bottom: 16;

							styles [
								"large",
							]

							ListBox folders {
								selection-mode: none;

								styles [
									"boxed-list",
								]
							}
						}
					}
				};
			}
		};
	}
}
