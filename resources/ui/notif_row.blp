using Gtk 4.0;
using Adw 1;

template $NotificationRow: Adw.Bin {
	summary: "";
	progress: -1.0;

	styles [
		"notif-row",
	]

	Box {
		orientation: vertical;

		CenterBox {
			[start]
			Label label_summary {}

			[end]
			Button close_button {
				icon-name: "window-close-symbolic";
				valign: center;
				vexpand: false;
				action-name: "default.activate";

				styles [
					"close",
					"pill",
				]
			}
		}

		ProgressBar progress_bar {
			styles [
				"notif-progress",
				"osd",
			]

			visible: false;
			valign: center;
			fraction: 0.5;
		}
	}
}
