using Gtk 4.0;
using Adw 1;

template $FileNameDialog: Adw.Dialog {
    title: _("Create/rename file");
    width-request: 300;

    Box {
        orientation: vertical;
        spacing: 24;
        margin-start: 24;
        margin-end: 24;
        margin-top: 24;
        margin-bottom: 24;

        Label title {
            styles[
                "title-2"
            ]
            label: _("Set file name…");
        }

        Entry entry {
            placeholder-text: _("File name");
        }

        Box {
            orientation: horizontal;
            spacing: 16;
            height-request: 32;
            homogeneous: true;
            styles[
                "response-area"
            ]

            Button {
                styles[
                    "text-button"
                ]
                hexpand: true;
                vexpand: true;
                action-name: "sheet.close";
                label: _("Cancel");
            }

            Button apply_button {
                styles[
                    "suggested-action",
                    "text-button"
                ]
                hexpand: true;
                vexpand: true;
                action-name: "default.activate";
                sensitive: false;
                label: _("Apply");
            }
        }
    }
}
