using Gtk 4.0;
using Adw 1;

template $FileNameDialog: Adw.Dialog {
    title: _("Set file name…");

    Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        Entry entry {
            placeholder-text: _("File name");
            margin-start: 16;
            margin-end: 16;
            margin-top: 16;
            margin-bottom: 16;
        }
    }
}
